<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaPagosServiceBus</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pagos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaPagosServiceBus.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body style="background-color:#0a0a0a;">

    <header>
        <nav class="navbar navbar-expand-sm" style="background:#111111; border-bottom:1px solid #2a2a2a; padding:.75rem 1.5rem;">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
                   asp-area="" asp-controller="Home" asp-action="Index"
                   style="color:#f5f5f5; font-family:'Outfit',sans-serif; font-size:1rem; letter-spacing:-.01em;">
                    <i class="bi bi-cpu" style="color:#f59e0b;"></i>
                    SistemaPagos<span style="color:#f59e0b;">ServiceBus</span>
                </a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        style="color:#737373;">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-2"
                               asp-area="" asp-controller="Home" asp-action="Index"
                               style="color:#a3a3a3; font-family:'Outfit',sans-serif; font-size:.88rem; transition:color .2s;"
                               onmouseover="this.style.color='#f5f5f5'" onmouseout="this.style.color='#a3a3a3'">
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-2"
                               asp-area="" asp-controller="Form" asp-action="Index"
                               style="color:#a3a3a3; font-family:'Outfit',sans-serif; font-size:.88rem; transition:color .2s;"
                               onmouseover="this.style.color='#f5f5f5'" onmouseout="this.style.color='#a3a3a3'">
                                Nueva Transacción
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-2"
                               asp-area="" asp-controller="Transaccion" asp-action="Index"
                               style="color:#a3a3a3; font-family:'Outfit',sans-serif; font-size:.88rem; transition:color .2s;"
                               onmouseover="this.style.color='#f5f5f5'" onmouseout="this.style.color='#a3a3a3'">
                                Transacciones
                            </a>
                        </li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer style="border-top:1px solid #2a2a2a; padding:1rem 1.5rem; margin-top:2rem;">
        <div class="container-fluid">
            <small style="color:#525252; font-family:'Outfit',sans-serif; font-size:.75rem;">
                &copy; 2026 SistemaPagosServiceBus
            </small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>